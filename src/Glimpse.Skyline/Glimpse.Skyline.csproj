<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: the Skyline JSON-RPC client uses named pipes, and Skyline is Windows-only.
         The ONLY project that link-compiles the vendored SkylineTool sources. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Glimpse.Skyline</RootNamespace>
    <!-- The vendored SkylineTool sources predate nullable reference types; Glimpse's own files opt in. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glimpse.Core\Glimpse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skyline writes reports as Parquet several times faster than as CSV. Same version as Skyline-PRISM. -->
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glimpse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\external\SkylineTool\SkylineJsonToolClient.cs" Link="Rpc\SkylineJsonToolClient.cs" />
    <Compile Include="..\..\external\SkylineTool\IJsonToolService.cs" Link="Rpc\IJsonToolService.cs" />
    <Compile Include="..\..\external\SkylineTool\JsonToolConstants.cs" Link="Rpc\JsonToolConstants.cs" />
    <Compile Include="..\..\external\SkylineTool\JsonToolModels.cs" Link="Rpc\JsonToolModels.cs" />
  </ItemGroup>

</Project>
