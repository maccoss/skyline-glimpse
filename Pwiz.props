<Project>

  <!--
    Where pwiz-sharp is, and how Glimpse gets its instrument-file readers.

    pwiz-sharp is the .NET port of the ProteoWizard core. It has no package feed, so Glimpse
    project-references an external checkout, the same way Skyline-PRISM does. The default is a
    sibling organization checkout: from this repo, ..\..\ProteoWizard\pwiz\pwiz-sharp. Override with

        dotnet build -p:PwizSharpDir=<path-to>/pwiz/pwiz-sharp

    Vendor SDKs are license-gated: without -p:IAgreeToVendorLicenses=true the Thermo reader compiles
    to a stub that recognizes a .raw and refuses to read it.

    GlimpseReaders selects where the readers come from:
      Bundled (default, today): project-reference pwiz-sharp and ship it in the tool zip.
      Skyline (future):         once Skyline ships on .NET 10 with pwiz-sharp and every vendor reader
                                in its installation, reference the same assemblies Private=false and
                                resolve them at runtime from the running Skyline's folder. Only
                                Glimpse.Pwiz may touch pwiz types, so that switch stays one project.
  -->
  <PropertyGroup>
    <PwizSharpDir Condition="'$(PwizSharpDir)' == ''">$(MSBuildThisFileDirectory)..\..\ProteoWizard\pwiz\pwiz-sharp</PwizSharpDir>
    <PwizMsDataProject>$(PwizSharpDir)\pwiz\src\MsData\MsData.csproj</PwizMsDataProject>
    <PwizThermoProject>$(PwizSharpDir)\pwiz\src\Vendor\Thermo\Thermo.csproj</PwizThermoProject>
    <PwizUtilProject>$(PwizSharpDir)\pwiz\src\Util\Util.csproj</PwizUtilProject>

    <PwizAvailable Condition="Exists('$(PwizMsDataProject)')">true</PwizAvailable>
    <PwizAvailable Condition="'$(PwizAvailable)' == ''">false</PwizAvailable>

    <GlimpseReaders Condition="'$(GlimpseReaders)' == ''">Bundled</GlimpseReaders>
  </PropertyGroup>

</Project>
